# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Local runtime artifacts (all are LOCAL STAND-INS for Azure services) ---
# local.db      -> Azure SQL Database
# storage/      -> Azure Blob Storage
# logs/         -> Azure Monitor / alert delivery logs
# ai/rag/faiss_index/ -> FAISS index build output
# *.pt          -> downloaded model weights (e.g. yolov8n.pt)
local.db
storage/
logs/
ai/rag/faiss_index/
*.pt
.env

# --- Phase-3: large datasets & training runs (never commit) ---
*.zip
data/flame/
data/firenet/
runs/
ai/models/weights/*.pt

# --- Node / React ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS ---
.DS_Store
Thumbs.db

# --- results: keep READMEs + .gitkeep + last_run.json, ignore other run outputs ---
results/yolo-metrics/*
results/rag-metrics/*
results/latency/*
!results/*/.gitkeep
!results/yolo-metrics/last_run.json
!results/yolo-metrics/train_*.json
!results/rag-metrics/rag_eval.json

# Phase-3 derived dataset dirs
data/firenet_yolo/
data/flame_cls/

# Terraform
cloud/terraform/.terraform/
cloud/terraform/*.tfstate*
cloud/terraform/terraform.tfvars
cloud/terraform/.terraform.lock.hcl
frontend/.env.production
cloud/terraform/tfplan
cloud/terraform/*.tfplan
