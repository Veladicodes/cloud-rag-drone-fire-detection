# ============================================================================
#  Environment configuration — Phase-2 local prototype
# ----------------------------------------------------------------------------
#  Every value below is a LOCAL STAND-IN for a real Azure service. Swapping to
#  production = change these values, not the code. The "Azure equivalent" note
#  on each line says what it becomes.
# ============================================================================

# LOCAL STAND-IN FOR: Azure SQL Database.
# Prod: mssql+pyodbc://<user>:<pw>@<server>.database.windows.net/<db>?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./local.db

# Blob storage backend.
#   local = filesystem stand-in under STORAGE_PATH (default; no account)
#   azure = real Azure Blob Storage via AZURE_STORAGE_CONNECTION_STRING
STORAGE_MODE=local
STORAGE_PATH=./storage
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_BLOB_CONTAINER=incident-snapshots

# Response-plan LLM.
#   mock   = deterministic, clearly-labelled "[MOCK LLM OUTPUT]" (no key; default)
#   local  = a small local transformers model, falls back to mock
#   gemini = REAL generation via Google Gemini Flash. Needs the two vars below.
#            Get a free key at https://aistudio.google.com/apikey (free tier ~5 req/min).
LLM_MODE=mock
# GEMINI_API_KEY=your-key-here          # never commit a real key; .env is git-ignored
# GEMINI_MODEL=gemini-2.5-flash       # stable; free tier. Or gemini-flash-latest for newest.

# Embedding backend for the RAG index.
#   auto = use sentence-transformers/all-mpnet-base-v2 (768-dim) if installed, else hash fallback
#   hash = deterministic non-semantic fallback embedder (for offline CI only)
EMBED_MODE=auto

# YOLO detector backend.
#   auto      = ultralytics pretrained yolov8n.pt (COCO PLACEHOLDER, not wildfire-tuned)
#   finetuned = ai/models/weights/wildfire_yolov8n.pt (FireNet-trained detector)
#   stub      = dependency-free synthetic detector
YOLO_MODE=auto

# SOP corpus that the FAISS index is built from.
KB_PATH=./data/knowledge-base/sample_sops
FAISS_INDEX_PATH=./ai/rag/faiss_index

# LOCAL MOCK FOR: Azure Communication Services (SMS) + Azure Notification Hubs (push).
ALERT_LOG_PATH=./logs/alerts.log

# Minimum YOLO confidence that qualifies a detection as an incident worth alerting on.
CONFIDENCE_THRESHOLD=0.35

# Run the RAG pipeline synchronously inside POST /api/v1/incidents instead of as a
# background task. Tests set this to true; the live demo leaves it false.
SYNC_RAG=false

# CORS origin for the React dev server.
FRONTEND_ORIGIN=http://localhost:5173
